# Shufersal Local API Wrapper Configuration

# Required: Secret Bearer token for API access (generate a strong random string)
SHUFERSAL_API_TOKEN=change_me_to_a_long_random_secret_token

# Directory where Playwright keeps persistent browser state (cookies, login session)
SHUFERSAL_PROFILE_DIR=./user_data

# Local server binding
HOST=127.0.0.1
PORT=8000

# Browser options
HEADLESS=true
MOCK_MODE=false
